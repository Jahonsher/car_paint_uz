# Public API URL; CRA exposes REACT_APP_* values in browser bundles.
# Never put API secrets, private tokens, or passwords in REACT_APP_* variables.
# Optional: the app defaults to this URL when no .env file exists.
REACT_APP_API_URL=https://server.carpaint.uz/api/v1

# Optional local development port (default: 3000).
PORT=3000
